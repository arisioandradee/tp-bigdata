# Copie para .env e preencha. NUNCA versionar o .env.
# Gere valores fortes, por exemplo: python -c "import secrets;print(secrets.token_urlsafe(24))"

# Kafka (KRaft)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC_PARTITIONS=3

# Elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTIC_PASSWORD=troque-esta-senha
KIBANA_PASSWORD=troque-esta-senha
ES_EXPORTER_PASSWORD=troque-esta-senha

# Redis
REDIS_PASSWORD=troque-esta-senha

# LDAP
LDAP_ORGANISATION=UniCatolica Quixada
LDAP_DOMAIN=enade.local
LDAP_ADMIN_PASSWORD=troque-esta-senha
LDAP_ESTUDANTE_SENHA=troque-esta-senha
LDAP_PROFESSOR_SENHA=troque-esta-senha

# Kerberos
KRB_REALM=ENADE.LOCAL
KRB_MASTER_PASSWORD=troque-esta-senha

# API (AUTH_MODE: ldap | dev)
AUTH_MODE=ldap
JWT_SECRET=troque-este-segredo
DEV_ESTUDANTE_SENHA=troque-esta-senha
DEV_PROFESSOR_SENHA=troque-esta-senha
CACHE_TTL=300

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-esta-senha